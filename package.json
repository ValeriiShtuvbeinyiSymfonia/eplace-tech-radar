{
  "name": "eplace-tech-radar",
  "version": "2025.1.0",
  "description": "ePłace Technology Radar - Visualizing our technology choices",
  "homepage": "https://ValeriiShtuvbeinyiSymfonia.github.io/eplace-tech-radar",
  "repository": "https://github.com/ValeriiShtuvbeinyiSymfonia/eplace-tech-radar.git",
  "license": "MIT",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "browser-sync": "^3.0.2",
    "eslint": "^8.52.0",
    "eslint-plugin-html": "^7.1.0",
    "socket.io": "^4.7.2",
    "gh-pages": "^6.1.1"
  },
  "scripts": {
    "start": "browser-sync docs -w",
    "build": "npm run clean && npm run copy-files",
    "clean": "rm -rf dist",
    "copy-files": "mkdir -p dist && cp -r docs/* dist/",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint docs/*.js",
    "lint:html": "eslint docs/*.html"
  }
}
